# EditorConfig for EchoLisp
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Scheme/Lisp files with .echo.* naming convention
[*.echo.{scm,s,ls,lsp,lisp,glisp}]
indent_style = space
indent_size = 2
max_line_length = 100

# Legacy files without .echo. prefix (for compatibility)
[*.{scm,s,ls,lsp,lisp,glisp}]
indent_style = space
indent_size = 2
max_line_length = 100

# Markdown files
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# YAML files (for GitHub Actions, etc.)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# JavaScript files
[*.js]
indent_style = space
indent_size = 2

# HTML files
[*.html]
indent_style = space
indent_size = 2

# CSS files
[*.css]
indent_style = space
indent_size = 2
